{
  "name": "@ogun/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "esbuild test/render.test.tsx --bundle --platform=node --format=cjs --outfile=test-build/render.test.cjs --log-level=error && node --test test-build/render.test.cjs",
    "test:e2e": "pnpm build && node --test --test-concurrency=1 e2e/*.test.ts && node e2e/screenshots.ts",
    "screenshots": "pnpm build && node e2e/screenshots.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.25.12",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^6.0.0"
  }
}
